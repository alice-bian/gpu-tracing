#version 460
#extension GL_EXT_ray_tracing : enable
#extension GL_GOOGLE_include_directive : enable

#include "common.glsl"

layout(binding = 0, set = 0, rgba32f) uniform image2D outputImage;
layout(binding = 1, set = 0) uniform accelerationStructureEXT topLevelAS;
layout(location = 0) rayPayloadEXT PathPayload payload;

const int MAX_PATH_BOUNCES = 4;

uint makeSeed(uvec2 pixel, uint frameIndex) {
    return pixel.x * 1973u + pixel.y * 9277u + frameIndex * 26699u;
}

vec3 rayDirection(vec2 fragCoord) {
    vec2 uv = (fragCoord / vec2(pc.width, pc.height)) * 2.0 - vec2(1.0);
    uv.y = -uv.y;

    float theta = radians(pc.fov);
    float halfHeight = tan(theta * 0.5);
    float halfWidth = pc.aspect * halfHeight;

    return normalize(uv.x * halfWidth * pc.u + uv.y * halfHeight * pc.v - pc.w);
}

void main() {
    uvec2 launchId = gl_LaunchIDEXT.xy;
    vec2 fragCoord = vec2(launchId) + vec2(0.5);

    vec3 currentOrigin = pc.origin;
    vec3 currentDirection = rayDirection(fragCoord);
    vec3 throughput = vec3(1.0);
    vec3 finalColor = vec3(0.0);

    uint seed = makeSeed(launchId, uint(pc.frame));

    for (int bounce = 0; bounce < MAX_PATH_BOUNCES; bounce++) {
        payload.radiance = vec3(0.0);
        payload.seed = seed;
        payload.attenuation = vec3(1.0);
        payload.state = 0u;
        payload.scatterOrigin = vec3(0.0);
        payload.pad0 = 0.0;
        payload.scatterDirection = vec3(0.0);
        payload.pad1 = 0.0;

        traceRayEXT(topLevelAS,
                    gl_RayFlagsOpaqueEXT,
                    0xFF,
                    0,
                    0,
                    0,
                    currentOrigin,
                    0.001,
                    currentDirection,
                    10000.0,
                    0);

        seed = payload.seed;

        if (payload.state == 1u) {
            throughput *= payload.attenuation;
            currentOrigin = payload.scatterOrigin;
            currentDirection = normalize(payload.scatterDirection);
            continue;
        }

        finalColor += throughput * payload.radiance;
        break;
    }

    imageStore(outputImage, ivec2(launchId), vec4(finalColor, 1.0));
}
